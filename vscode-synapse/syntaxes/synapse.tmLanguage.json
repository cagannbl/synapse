{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Synapse",
  "scopeName": "source.synapse",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#ai-keywords" },
    { "include": "#keywords" },
    { "include": "#neural-network" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#function-defs" },
    { "include": "#function-calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.synapse",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.synapse",
          "begin": "f?\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.synapse",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.synapse",
          "begin": "f?'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.synapse",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "ai-keywords": {
      "patterns": [
        {
          "name": "keyword.control.ai.synapse",
          "match": "\\b(tensor|prompt|agent|tool|grad)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.synapse",
          "match": "\\b(if|elif|else|while|for|in|return|pass|break|continue|import|from|as)\\b"
        },
        {
          "name": "storage.type.synapse",
          "match": "\\b(let|const|fn|def)\\b"
        },
        {
          "name": "keyword.operator.logical.synapse",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "neural-network": {
      "patterns": [
        {
          "name": "support.class.neural.synapse",
          "match": "\\b(Linear|Sequential|ReLU|Sigmoid|MSELoss|CrossEntropyLoss|Adam|SGD|Module)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.synapse",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.matmul.synapse",
          "match": "@=?|->"
        },
        {
          "name": "keyword.operator.comparison.synapse",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.synapse",
          "match": "\\*\\*|//|\\+|-|\\*|/|%|="
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.synapse",
          "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.synapse",
          "match": "\\b(true|false|True|False|none|None)\\b"
        }
      ]
    },
    "function-defs": {
      "patterns": [
        {
          "match": "\\b(fn|def|prompt|tool)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.synapse" },
            "2": { "name": "entity.name.function.synapse" }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.synapse" }
          }
        }
      ]
    }
  }
}
