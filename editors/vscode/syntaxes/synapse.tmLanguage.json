{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Synapse",
  "scopeName": "source.synapse",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#ai-keywords" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#neural-network" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#function-defs" },
    { "include": "#function-calls" },
    { "include": "#variable-declarations" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.synapse",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.synapse",
          "begin": "f?\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.synapse",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.synapse",
          "begin": "f?'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.synapse",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "ai-keywords": {
      "patterns": [
        {
          "name": "keyword.control.ai.synapse",
          "match": "\\b(tensor|prompt|agent|tool|grad)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.synapse",
          "match": "\\b(if|elif|else|while|for|in|return|pass|break|continue|import|from|as|enum)\\b"
        },
        {
          "name": "storage.type.synapse",
          "match": "\\b(let|const|fn|def|enum)\\b"
        },
        {
          "name": "keyword.operator.logical.synapse",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.synapse",
          "match": "\\b(Tensor|int|float|str|bool|list|dict|void|Option|Some|Result|Ok|Err|Any)\\b"
        }
      ]
    },
    "neural-network": {
      "patterns": [
        {
          "name": "support.class.neural.synapse",
          "match": "\\b(Linear|Sequential|ReLU|Sigmoid|Tanh|Dropout|BatchNorm|Conv2d|MaxPool2d|MSELoss|CrossEntropyLoss|Adam|SGD|RMSprop|Module)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.synapse",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.matmul.synapse",
          "match": "@=?|->"
        },
        {
          "name": "keyword.operator.comparison.synapse",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.synapse",
          "match": "\\+=|-=|\\*=|/=|@=|="
        },
        {
          "name": "keyword.operator.arithmetic.synapse",
          "match": "\\*\\*|//|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.arrow.synapse",
          "match": "->|=>"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.synapse",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.synapse",
          "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.synapse",
          "match": "\\b(true|false|none|True|False|None)\\b"
        }
      ]
    },
    "function-defs": {
      "patterns": [
        {
          "match": "\\b(fn|def|prompt|tool)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.synapse" },
            "2": { "name": "entity.name.function.synapse" }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.synapse" }
          }
        }
      ]
    },
    "variable-declarations": {
      "patterns": [
        {
          "match": "\\b(let|const)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.synapse" },
            "2": { "name": "variable.other.synapse" }
          }
        }
      ]
    }
  }
}
